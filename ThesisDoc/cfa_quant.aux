\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Model pipeline from data to portfolio weights. \emph  {Green}: data and estimation. \emph  {Blue}: signal construction. \emph  {Orange}: Stage~1 selects the sector tilt from the predictive mixture moments alone and is insulated from the volatility and correlation signals. \emph  {Red}: Stage~2, where those signals act. \emph  {Grey}: assembly under the hybrid-B displacement rule, net of transaction costs.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{4}{Model pipeline from data to portfolio weights. \emph {Green}: data and estimation. \emph {Blue}: signal construction. \emph {Orange}: Stage~1 selects the sector tilt from the predictive mixture moments alone and is insulated from the volatility and correlation signals. \emph {Red}: Stage~2, where those signals act. \emph {Grey}: assembly under the hybrid-B displacement rule, net of transaction costs}{figure.caption.2}{}}
